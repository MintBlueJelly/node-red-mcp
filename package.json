{
  "name": "node-red-mcp",
  "description": "MCP server for authoring and troubleshooting Node-RED flows over the Admin API and the editor WebSocket",
  "version": "2.0.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "node-red": "5.0.8"
  }
}
